# Copie para .env e preencha com os valores do seu projeto Supabase /
# Lovable Cloud. Nunca comite o .env de verdade (ele já está no
# .gitignore) — este arquivo é só o modelo, sem valores reais.

# --- Supabase (cliente + servidor) ---
# Client-side (Vite injeta variáveis com prefixo VITE_ no bundle do navegador
# — nunca coloque nada sensível aqui, elas ficam públicas).
VITE_SUPABASE_PROJECT_ID=""
VITE_SUPABASE_PUBLISHABLE_KEY=""
VITE_SUPABASE_URL=""

# Server-side (mesmos valores, sem prefixo VITE_, para uso em server
# functions/SSR que rodam fora do bundle do navegador).
SUPABASE_PROJECT_ID=""
SUPABASE_PUBLISHABLE_KEY=""
SUPABASE_URL=""

# Chave de serviço (service_role) — bypassa RLS. NUNCA usar com prefixo
# VITE_, nunca expor ao cliente. Só para operações administrativas em
# server functions/rotas de servidor.
SUPABASE_SERVICE_ROLE_KEY=""

# --- Integrações de terceiros ---
# Telegram: token do bot (BotFather) usado para notificações e o webhook
# de categorização por chat.
TELEGRAM_BOT_TOKEN=""

# Anthropic: usado para interpretar a categorização de lançamentos
# enviada pelo usuário via Telegram.
ANTHROPIC_API_KEY=""

# Groq: usado para transcrever mensagens de voz do Telegram (Whisper).
GROQ_API_KEY=""

# Chave de criptografia (AES-256-GCM) do client secret da Pluggy de cada
# usuário, guardado em profiles.pluggy_client_secret. 32 bytes em hex —
# gere com `openssl rand -hex 32` e nunca reaproveite outra chave. Trocar
# essa chave invalida todos os client secrets já salvos (o usuário
# precisaria recadastrar em Configurações).
PLUGGY_SECRET_ENCRYPTION_KEY=""

# --- Cron interno (Lovable Cloud) ---
# Segredo(s) que autenticam a chamada do cron diário (sincronização
# bancária + resumos do Telegram). *_PREVIOUS permite rotacionar o
# segredo sem quebrar uma execução em andamento.
LOVABLE_CRON_SECRET=""
LOVABLE_CRON_SECRET_PREVIOUS=""

# --- Endpoint de debug SQL (opcional, só para ambientes de
# desenvolvimento/homologação) ---
# Protege /api/public/debug/sql. Gere um valor aleatório longo (ex.:
# `openssl rand -hex 32`) — nunca reaproveite outro segredo. Considere
# não configurar essa variável em produção se ninguém estiver usando essa
# ferramenta de debug ativamente.
DEBUG_SQL_TOKEN=""
